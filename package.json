{
  "name": "vocabulario",
  "version": "0.1.0",
  "description": "Aprende vocabulario con cuestionarios",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "prepare": "svelte-kit sync || echo ''",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "tauri": "tauri",
    "postinstall": "node scripts/fetch-assets.mjs",
    "fetch-assets": "node scripts/fetch-assets.mjs",
    "test": "vitest run --dir tests"
  },
  "license": "MIT",
  "dependencies": {
    "@huggingface/transformers": "^4.3.1",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2.8.1",
    "@tauri-apps/plugin-sql": "^2.5.0"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.10",
    "@sveltejs/kit": "^2.65.1",
    "@sveltejs/vite-plugin-svelte": "^7.1.2",
    "@tauri-apps/cli": "^2",
    "@types/sql.js": "^1.4.11",
    "sql.js": "^1.14.2",
    "svelte": "^5.56.3",
    "svelte-check": "^4.6.0",
    "typescript": "~6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.11"
  }
}
